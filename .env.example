APP_NAME="King Lotus Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=king_lotus
DB_USERNAME=
DB_PASSWORD=
DB_AUTH_DATABASE=king_lotus
DB_CONTENT_DATABASE=king_lotus

# Proxy & CDN trust configuration:
# For direct cPanel hosting, leave TRUSTED_PROXIES empty so arbitrary proxy headers are ignored.
# If using Cloudflare or a reverse proxy in staging/production, list verified proxy IP ranges here (comma-separated).
TRUSTED_PROXIES=

# Session Security:
# Keep SESSION_DOMAIN empty unless cross-subdomain sharing is genuinely required.
# In production on HTTPS, set SESSION_SECURE_COOKIE=true and SESSION_COOKIE can use __Host- prefix (e.g. __Host-klg_session).
SESSION_COOKIE=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Database migration trigger token (optional; if unset, unauthenticated /admin/system/migrate is disabled)
MIGRATION_SECRET=

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local development and cPanel production write to a persistent public root.
# On cPanel set this to the absolute path of the subdomain's Laravel public directory.
UPLOADS_DRIVER=local
UPLOADS_URL="${APP_URL}"
UPLOADS_LOCAL_ROOT=
UPLOADS_MAX_TOTAL_BYTES=1073741824
UPLOADS_VISIBILITY=public

# Optional S3-compatible values; not required for the selected cPanel deployment.
UPLOADS_ACCESS_KEY_ID=
UPLOADS_SECRET_ACCESS_KEY=
UPLOADS_DEFAULT_REGION=auto
UPLOADS_BUCKET=
UPLOADS_ENDPOINT=
UPLOADS_PREFIX=
UPLOADS_USE_PATH_STYLE_ENDPOINT=false

# Browser Security, CSP & HSTS:
# Set CSP_REPORT_ONLY=true during rollout or debugging to observe violations without enforcement.
CSP_REPORT_ONLY=false
# HSTS is sent only over secure HTTPS connections. Keep subdomains/preload disabled for dedicated subdomain safety.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

VITE_APP_NAME="${APP_NAME}"
